# server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Public base URL of this backend, used to build webhook URLs handed to LNbits
BITCOMUT_BASE_URL=http://localhost:4000

# postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitcomut

# LNbits
LNBITS_BASE_URL=http://localhost:5000
LNBITS_ADMIN_KEY=
LNBITS_INVOICE_KEY=
LNBITS_WEBHOOK_SECRET=change-me-webhook-secret

# FX
FX_PROVIDER=static
BTC_RWF_RATE_FALLBACK=480000000

# security
JWT_SECRET=change-me
COOKIE_NAME=bitcomut:tenant

# settlement (simulated)
SETTLEMENT_DELAY_MS=15000
WITHDRAWAL_DELAY_MS=15000

# polling reconciliation of LNbits payments
RECONCILE_CRON=*/30 * * * * *
