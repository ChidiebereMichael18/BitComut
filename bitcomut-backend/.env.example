# ============================================================
#  BitPulse Backend Environment Configuration
#  Copy this file to `.env` and fill in the values.
#  NEVER commit the real `.env`.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL (Docker) ---
PGHOST=localhost
PGPORT=5432
PGUSER=bitpulse
PGPASSWORD=CHANGE_ME
PGDATABASE=bitpulse

# --- FX Rates ---
# Provider for BTC/fiat exchange rates. Leave the KEY blank for now;
# you will fill these in with your own keys.
FX_PROVIDER_ID=      # e.g. coingecko, openexchangerates, coinbase
FX_API_KEY=          # <-- YOUR API KEY HERE (leave blank if using a no-key provider)

# --- Lightning Network ---
# Option A (RECOMMENDED): Voltage cloud node over REST — no WSL, no local node.
# Set VOLTAGE_ENABLED=true once you have created the node and filled these in.
VOLTAGE_ENABLED=false        # set true to use your hosted Voltage LND node
VOLTAGE_LND_URL=             # node REST URL from Voltage 'Node Details', e.g. https://xxxx.lnd.voltageapp.io:8080
VOLTAGE_MACAROON=            # node Admin macaroon (hex) from your node's dashboard
VOLTAGE_INFRA_KEY=           # voltage Infrastructure API key (vltg_) — node management, stored here not committed

# Option B: local LND over gRPC (e.g. in WSL). Only used if Voltage is disabled.
LND_GRPC_HOST=localhost:10009
LND_TLS_CERT_PATH=# /home/REB/.lnd/tls.cert
LND_MACAROON_PATH=# /home/REB/.lnd/data/chain/bitcoin/regtest/admin.macaroon
LND_NETWORK=regtest

# --- Corridor for MVP: Nigeria (NGN) -> Rwanda (RWF) ---
CORRIDOR_FROM=CURRENCY_NGN
CORRIDOR_TO=CURRENCY_RWF

# --- Settlement ledger ---
SETTLEMENT_MODE=simulated   # simulated | real
